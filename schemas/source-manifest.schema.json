{
  "$id": "source-manifest.schema.json",
  "type": "object",
  "required": ["sourceId", "repository", "commit", "file", "language", "work", "license", "licenseUrl", "retrievedAt"],
  "properties": {
    "sourceId": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "commit": { "type": "string", "minLength": 1 },
    "file": { "type": "string", "minLength": 1 },
    "canonicalIdentifier": { "type": "string" },
    "language": { "type": "string", "minLength": 2 },
    "author": { "type": ["string", "null"] },
    "work": { "type": "string", "minLength": 1 },
    "edition": { "type": ["string", "null"] },
    "translator": { "type": ["string", "null"] },
    "license": { "type": "string", "minLength": 1 },
    "licenseUrl": { "type": "string", "minLength": 1 },
    "retrievedAt": { "type": "string", "minLength": 1 },
    "rawSource": {
      "type": "object",
      "required": ["path", "checksumAlgorithm", "checksum"],
      "properties": {
        "path": { "type": "string" },
        "checksumAlgorithm": { "const": "sha256" },
        "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  },
  "additionalProperties": true
}
