{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tanyagupta/story/schemas/production-myth.schema.json",
  "title": "AI Constructed Production Myth",
  "type": "object",
  "required": [
    "id",
    "title",
    "mythFamily",
    "status",
    "provenance",
    "referenceLinks",
    "scope",
    "variant",
    "characters",
    "relationships",
    "narrative",
    "events",
    "locations",
    "themes",
    "adaptation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^production-myth-[0-9]{4}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "mythFamily": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "ai_constructed_production"
    },
    "provenance": {
      "type": "object",
      "required": [
        "type",
        "specificSourceVerified",
        "constructionPolicy",
        "basedOnSourceAuditedReference"
      ],
      "properties": {
        "type": {
          "const": "ai_constructed"
        },
        "specificSourceVerified": {
          "const": false
        },
        "constructionPolicy": {
          "type": "string",
          "minLength": 1
        },
        "basedOnSourceAuditedReference": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "referenceLinks": {
      "type": "object",
      "required": [
        "sourceAuditedRecordIds"
      ],
      "properties": {
        "sourceAuditedRecordIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "scope": {
      "type": "object",
      "required": [
        "beginning",
        "ending",
        "boundaryRationale"
      ],
      "properties": {
        "beginning": {
          "type": "string",
          "minLength": 1
        },
        "ending": {
          "type": "string",
          "minLength": 1
        },
        "boundaryRationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "variant": {
      "type": "object",
      "required": [
        "chosenVersion",
        "materialAlternatives"
      ],
      "properties": {
        "chosenVersion": {
          "type": "string",
          "minLength": 1
        },
        "materialAlternatives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "role",
          "goal"
        ]
      }
    },
    "relationships": {
      "type": "array"
    },
    "narrative": {
      "type": "object",
      "required": [
        "synopsis",
        "openingSituation",
        "centralConflict",
        "resolution",
        "outcome"
      ]
    },
    "events": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "actor",
          "action",
          "target",
          "consequence",
          "factIds"
        ]
      }
    },
    "locations": {
      "type": "array",
      "minItems": 1
    },
    "themes": {
      "type": "array"
    },
    "adaptation": {
      "type": "object",
      "required": [
        "recommendedSceneCount",
        "visualBeats",
        "sensitiveContent",
        "productionNotes"
      ]
    }
  },
  "additionalProperties": true
}
