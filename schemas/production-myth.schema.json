{
  "$id": "production-myth.schema.json",
  "type": "object",
  "required": [
    "id",
    "title",
    "mythFamily",
    "status",
    "provenance",
    "referenceLinks",
    "scope",
    "variant",
    "coreFacts",
    "characters",
    "relationships",
    "narrative",
    "events",
    "locations",
    "objects",
    "creatures",
    "themes",
    "adaptation"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^production-myth-[0-9]{4}$" },
    "title": { "type": "string", "minLength": 1 },
    "mythFamily": { "type": "string", "minLength": 1 },
    "status": { "const": "ai_constructed_production" },
    "provenance": {
      "type": "object",
      "required": ["type", "specificSourceVerified", "basedOnSourceAuditedReference"],
      "properties": {
        "type": { "const": "ai_constructed" },
        "specificSourceVerified": { "const": false },
        "constructionPolicy": { "type": "string" },
        "sourceTruthPolicy": { "type": "string" },
        "basedOnSourceAuditedReference": { "const": true }
      }
    },
    "referenceLinks": {
      "type": "object",
      "required": ["sourceAuditedRecordIds", "sourceAuditedFiles"],
      "properties": {
        "sourceAuditedRecordIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "type": "string" }
        },
        "sourceAuditedFiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "scope": {
      "type": "object",
      "required": ["type", "beginning", "ending", "boundaryRationale", "includedPassages"],
      "properties": {
        "type": { "type": "string" },
        "beginning": { "type": "string", "minLength": 1 },
        "ending": { "type": "string", "minLength": 1 },
        "boundaryRationale": { "type": "string", "minLength": 20 },
        "includedPassages": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "omittedPassages": { "type": "array", "items": { "type": "string" } }
      }
    },
    "variant": {
      "type": "object",
      "required": ["chosenVersion", "materialAlternatives", "variantNotes"],
      "properties": {
        "chosenVersion": { "type": "string", "minLength": 1 },
        "materialAlternatives": { "type": "array" },
        "variantNotes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "coreFacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["factId", "fact"],
        "properties": {
          "factId": { "type": "string" },
          "fact": { "type": "string", "minLength": 1 }
        }
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "role", "goal"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "role": { "type": "string" },
          "goal": { "type": ["string", "null"] }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "relationship", "target", "rationale"],
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string" },
          "relationship": { "type": "string" },
          "target": { "type": "string" },
          "rationale": { "type": "string", "minLength": 20 }
        }
      }
    },
    "narrative": {
      "type": "object",
      "required": ["synopsis", "openingSituation", "centralConflict", "resolution", "outcome", "storyline"],
      "properties": {
        "synopsis": { "type": "string", "minLength": 1 },
        "openingSituation": { "type": "string", "minLength": 1 },
        "centralConflict": { "type": "string", "minLength": 1 },
        "resolution": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 },
        "storyline": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sequence", "actor", "action", "sourceAction", "target", "object", "recipient", "location", "consequence", "factIds"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "actor": { "type": ["string", "null"] },
          "action": { "type": "string", "minLength": 1 },
          "sourceAction": { "type": "string", "minLength": 1 },
          "target": { "type": ["string", "null"] },
          "object": { "type": ["string", "null"] },
          "recipient": { "type": ["string", "null"] },
          "location": { "type": ["string", "null"] },
          "consequence": { "type": "string", "minLength": 1 },
          "factIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "locations": { "type": "array", "items": { "type": "string" } },
    "objects": { "type": "array", "items": { "type": "string" } },
    "creatures": { "type": "array", "items": { "type": "string" } },
    "themes": { "type": "array", "items": { "type": "string" } },
    "adaptation": {
      "type": "object",
      "required": ["recommendedSceneCount", "visualBeats", "sensitiveContent", "productionNotes"],
      "properties": {
        "recommendedSceneCount": { "type": "integer", "minimum": 1 },
        "visualBeats": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "sensitiveContent": { "type": "array", "items": { "type": "string" } },
        "productionNotes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
