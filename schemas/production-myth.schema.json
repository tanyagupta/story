{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tanyagupta/story/schemas/production-myth.schema.json",
  "title": "AI Constructed Production Myth",
  "type": "object",
  "required": [
    "id",
    "title",
    "mythFamily",
    "status",
    "provenance",
    "referenceLinks",
    "scope",
    "variantPolicy",
    "narrative",
    "mainCharacters",
    "relationships",
    "events",
    "locations",
    "themes",
    "adaptation",
    "qualityReview"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^production-myth-[0-9]{4}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "mythFamily": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "ai_constructed_production"
    },
    "provenance": {
      "type": "object",
      "required": [
        "type",
        "specificSourceVerified",
        "constructionPolicy",
        "variantPolicy",
        "basedOnSourceAuditedReference"
      ],
      "properties": {
        "type": {
          "const": "ai_constructed"
        },
        "specificSourceVerified": {
          "const": false
        },
        "constructionPolicy": {
          "type": "string"
        },
        "variantPolicy": {
          "type": "string"
        },
        "basedOnSourceAuditedReference": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "referenceLinks": {
      "type": "object",
      "required": [
        "sourceAuditedRecordIds",
        "relatedSourceProposalIds"
      ],
      "properties": {
        "sourceAuditedRecordIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relatedSourceProposalIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "type",
        "boundaryRationale",
        "excludedMaterial"
      ],
      "properties": {
        "type": {
          "enum": [
            "complete-episode",
            "coherent-subepisode",
            "cycle-summary"
          ]
        },
        "boundaryRationale": {
          "type": "string",
          "minLength": 1
        },
        "excludedMaterial": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "variantPolicy": {
      "type": "object"
    },
    "narrative": {
      "type": "object",
      "required": [
        "synopsis",
        "openingSituation",
        "centralConflict",
        "resolution",
        "outcome",
        "storyline"
      ]
    },
    "mainCharacters": {
      "type": "array",
      "minItems": 1
    },
    "supportingCharacters": {
      "type": "array"
    },
    "entityMappings": {
      "type": "array"
    },
    "relationships": {
      "type": "array"
    },
    "events": {
      "type": "array",
      "minItems": 1
    },
    "locations": {
      "type": "array",
      "minItems": 1
    },
    "themes": {
      "type": "array"
    },
    "adaptation": {
      "type": "object",
      "required": [
        "recommendedSceneCount",
        "visualMoments",
        "dialogueOpportunities",
        "sensitiveContent",
        "productionNotes"
      ]
    },
    "qualityReview": {
      "type": "object",
      "required": [
        "internalConsistencyPassed",
        "variantConsistencyPassed",
        "characterConsistencyPassed",
        "eventSequencePassed",
        "boundaryReviewPassed",
        "duplicateReviewPassed",
        "reviewNotes"
      ]
    }
  },
  "additionalProperties": true
}
