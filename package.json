{
  "name": "storyboard-to-video",
  "version": "1.0.0",
  "description": "Render JSON storyboards into MP4 videos with a bundled FFmpeg binary.",
  "main": "src/index.js",
  "bin": {
    "storyboard-render": "bin/storyboard-render.js"
  },
  "scripts": {
    "demo:assets": "node scripts/generate-demo-assets.js",
    "demo:preview": "npm run demo:assets && node bin/storyboard-render.js examples/animated-prometheus.storyboard.json --preview",
    "demo:render": "npm run demo:assets && node bin/storyboard-render.js examples/animated-prometheus.storyboard.json",
    "render": "node bin/storyboard-render.js",
    "sample:render": "node bin/storyboard-render.js examples/product-launch.storyboard.json --out renders/sample.mp4",
    "test": "node tests/run-tests.js"
  },
  "keywords": [
    "storyboard",
    "video",
    "ffmpeg"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ffmpeg-static": "4.4.0"
  },
  "engines": {
    "node": ">=14"
  }
}
