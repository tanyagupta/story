  "evidenceSummary": [
    {
      "passageId": "gutenberg:ebooks:22381:331.331.1-331.331.1:fd3d5628",
      "excerpt": "After the apotheosis of Heracles, his children were so cruelly persecuted by Eurystheus, that they fled for protection to king Ceyx at Trachin, accompanied by the aged Iolaus, the nephew and life-long friend of their father, who constituted himself their",
      "supports": [
        "openingSituation",
        "centralConflict"
      ]
    },
    {
      "passageId": "gutenberg:ebooks:22381:331.331.4-331.331.4:0fdbe390",
      "excerpt": "In the thick of the battle which ensued, Iolaus, following a sudden impulse, borrowed the chariot of Hyllus, and earnestly entreated Zeus and Hebe to restore to him, for this one day only, the vigour and strength of his youth. His prayer was heard.",
      "supports": [
        "resolution",
        "event-004"
      ]
    },
    {
      "passageId": "gutenberg:ebooks:22381:331.331.15-331.331.15:fdad853c",
      "excerpt": "And now success at length crowned the efforts of the long-suffering descendants of the great hero. They obtained possession of the Peloponnesus, which was divided among them by lot. Argos fell to Temenus, Lacedaemon to Aristodemus, and Messene to Cresphontes.",
      "supports": [
        "outcome"
      ]
    }
