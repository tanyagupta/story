        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "1",
        "end": "1"
      },
      "language": "grc",
      "text": "ἀμφὶ Διώνυσον, Σεμέλης ἐρικυδέος υἱόν,",
      "sequence": 1,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[1]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.2-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.2:8d465239",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "2",
        "end": "2"
      },
      "language": "grc",
      "text": "μνήσομαι, ὡς ἐφάνη παρὰ θῖν’ ἁλὸς ἀτρυγέτοιο",
      "sequence": 2,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[2]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.3-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.3:2389ef53",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "3",
        "end": "3"
      },
      "language": "grc",
      "text": "ἀκτῇ ἔπι προβλῆτι νεηνίῃ ἀνδρὶ ἐοικώς,",
      "sequence": 3,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[3]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.4-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.4:29756f32",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "4",
        "end": "4"
      },
      "language": "grc",
      "text": "πρωθήβῃ· καλαὶ δὲ περισσείοντο ἔθειραι,",
      "sequence": 4,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[4]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.5-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.5:ef19a26e",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "5",
        "end": "5"
      },
      "language": "grc",
      "text": "κυάνεαι, φᾶρος δὲ περὶ στιβαροῖς ἔχεν ὤμοις",
      "sequence": 5,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[5]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.6-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.6:1f038880",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "6",
        "end": "6"
      },
      "language": "grc",
      "text": "πορφύρεον· τάχα δ’ ἄνδρες ἐυσσέλμου ἀπὸ νηὸς",
      "sequence": 6,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[6]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.7-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.7:18669d21",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "7",
        "end": "7"
      },
      "language": "grc",
      "text": "ληισταὶ προγένοντο θοῶς ἐπὶ οἴνοπα πόντον,",
      "sequence": 7,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[7]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.8-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.8:c2657f50",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "8",
        "end": "8"
      },
      "language": "grc",
      "text": "Τυρσηνοί· τοὺς δ’ ἦγε κακὸς μόρος· οἳ δὲ ἰδόντες",
      "sequence": 8,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[8]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.9-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.9:4593467e",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "9",
        "end": "9"
      },
      "language": "grc",
      "text": "νεῦσαν ἐς ἀλλήλους, τάχα δ’ ἔκθορον. αἶψα δ’ ἑλόντες",
      "sequence": 9,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[9]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.10-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.10:b72ed5e3",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "10",
        "end": "10"
      },
      "language": "grc",
      "text": "εἷσαν ἐπὶ σφετέρης νηὸς κεχαρημένοι ἦτορ.",
      "sequence": 10,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[10]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.11-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.11:8cda318d",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "11",
        "end": "11"
      },
      "language": "grc",
      "text": "υἱὸν γάρ μιν ἔφαντο διοτρεφέων βασιλήων",
      "sequence": 11,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[11]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.12-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.12:db872e70",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "12",
        "end": "12"
      },
      "language": "grc",
      "text": "εἶναι καὶ δεσμοῖς ἔθελον δεῖν ἀργαλέοισι.",
      "sequence": 12,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[12]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.13-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.13:77002c1e",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "13",
        "end": "13"
      },
      "language": "grc",
      "text": "τὸν δ’ οὐκ ἴσχανε δεσμά, λύγοι δ’ ἀπὸ τηλόσε πῖπτον",
      "sequence": 13,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[13]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.14-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.14:b7f3418b",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "14",
        "end": "14"
      },
      "language": "grc",
      "text": "χειρῶν ἠδὲ ποδῶν· ὃ δὲ μειδιάων ἐκάθητο",
      "sequence": 14,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[14]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.15-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.15:0cd80849",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "15",
        "end": "15"
      },
      "language": "grc",
      "text": "ὄμμασι κυανέοισι· κυβερνήτης δὲ νοήσας",
      "sequence": 15,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[15]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.16-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.16:719bd8fe",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "16",
        "end": "16"
      },
      "language": "grc",
      "text": "αὐτίκα οἷς ἑτάροισιν ἐκέκλετο φώνησέν τε·",
      "sequence": 16,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[16]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.17-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.17:de28c731",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "17",
        "end": "17"
      },
      "language": "grc",
      "text": "δαιμόνιοι, τίνα τόνδε θεὸν δεσμεύεθ’ ἑλόντες,",
      "sequence": 17,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[17]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.18-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.18:91a5f3bf",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "18",
        "end": "18"
      },
      "language": "grc",
      "text": "καρτερόν; οὐδὲ φέρειν δύναταί μιν νηῦς εὐεργής.",
      "sequence": 18,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[18]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.19-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.19:498b6830",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "19",
        "end": "19"
      },
      "language": "grc",
      "text": "ἢ γὰρ Ζεὺς ὅδε γ’ ἐστὶν ἢ ἀργυρότοξος Ἀπόλλων",
      "sequence": 19,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[19]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.20-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.20:53a56485",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "20",
        "end": "20"
      },
      "language": "grc",
      "text": "ἠὲ Ποσειδάων· ἐπεὶ οὐ θνητοῖσι βροτοῖσιν",
      "sequence": 20,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[20]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.21-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.21:76b045f4",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "21",
        "end": "21"
      },
      "language": "grc",
      "text": "εἴκελος, ἀλλὰ θεοῖς, οἳ Ὀλύμπια δώματ’ ἔχουσιν.",
      "sequence": 21,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[21]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.22-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.22:fc2f9c4c",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "22",
        "end": "22"
      },
      "language": "grc",
      "text": "ἀλλ’ ἄγετ’, αὐτὸν ἀφῶμεν ἐπ’ ἠπείροιο μελαίνης",
      "sequence": 22,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[22]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.23-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.23:b2ff11cd",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "23",
        "end": "23"
      },
      "language": "grc",
      "text": "αὐτίκα· μηδ’ ἐπὶ χεῖρας ἰάλλετε, μή τι χολωθεὶς",
      "sequence": 23,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[23]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.24-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.24:b8a38aa6",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "24",
        "end": "24"
      },
      "language": "grc",
      "text": "ὄρσῃ ἔπ’ ἀργαλέους τ’ ἀνέμους καὶ λαίλαπα πολλήν.",
      "sequence": 24,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[24]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.25-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.25:977aeab7",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "25",
        "end": "25"
      },
      "language": "grc",
      "text": "Ὣς φάτο· τὸν δ’ ἀρχὸς στυγερῷ ἠνίπαπε μύθῳ·",
      "sequence": 25,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[25]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.26-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.26:28b17bf3",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "26",
        "end": "26"
      },
      "language": "grc",
      "text": "δαιμόνι’, οὖρον ὅρα, ἅμα δ’ ἱστίον ἕλκεο νηὸς",
      "sequence": 26,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[26]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.27-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.27:402370cd",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "27",
        "end": "27"
      },
      "language": "grc",
      "text": "σύμπανθ’ ὅπλα λαβών· ὅδε δ’ αὖτ’ ἄνδρεσσι μελήσει.",
      "sequence": 27,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[27]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.28-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.28:c9719e44",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "28",
        "end": "28"
      },
      "language": "grc",
      "text": "ἔλπομαι, ἢ Αἴγυπτον ἀφίξεται ἢ ὅ γε Κύπρον",
      "sequence": 28,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[28]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.29-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.29:4cabf367",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "29",
        "end": "29"
      },
      "language": "grc",
      "text": "ἢ ἐς Ὑπερβορέους ἢ ἑκαστέρω· ἐς δὲ τελευτὴν",
      "sequence": 29,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[29]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.30-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.30:0aea2447",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "30",
        "end": "30"
      },
      "language": "grc",
      "text": "ἔκ ποτ’ ἐρεῖ αὐτοῦ τε φίλους καὶ κτήματα πάντα",
      "sequence": 30,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[30]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.31-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.31:1e427e4b",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "31",
        "end": "31"
      },
      "language": "grc",
      "text": "οὕς τε κασιγνήτους, ἐπεὶ ἡμῖν ἔμβαλε δαίμων.",
      "sequence": 31,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[31]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.32-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.32:8b3b216d",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "32",
        "end": "32"
      },
      "language": "grc",
      "text": "ὣς εἰπὼν ἱστόν τε καὶ ἱστίον ἕλκετο νηός.",
      "sequence": 32,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[32]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.33-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.33:e49acd6c",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "33",
        "end": "33"
      },
      "language": "grc",
      "text": "ἔμπνευσεν δ’ ἄνεμος μέσον ἱστίον· ἀμφὶ δ’ ἄρ’ ὅπλα",
      "sequence": 33,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[33]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.34-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.34:24f6eac5",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "34",
        "end": "34"
      },
      "language": "grc",
      "text": "καττάνυσαν· τάχα δέ σφιν ἐφαίνετο θαυματὰ ἔργα.",
      "sequence": 34,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[34]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.35-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.35:cb2b4845",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "35",
        "end": "35"
      },
      "language": "grc",
      "text": "οἶνος μὲν πρώτιστα θοὴν ἀνὰ νῆα μέλαιναν",
      "sequence": 35,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[35]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.36-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.36:c80d5715",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "36",
        "end": "36"
      },
      "language": "grc",
      "text": "ἡδύποτος κελάρυζ’ εὐώδης, ὤρνυτο δ’ ὀδμὴ",
      "sequence": 36,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[36]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.37-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.37:d879f6f2",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "37",
        "end": "37"
      },
      "language": "grc",
      "text": "ἀμβροσίη· ναύτας δὲ τάφος λάβε πάντας ἰδόντας.",
      "sequence": 37,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[37]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.38-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.38:eba8a1a6",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "38",
        "end": "38"
      },
      "language": "grc",
      "text": "αὐτίκα δ’ ἀκρότατον παρὰ ἱστίον ἐξετανύσθη",
      "sequence": 38,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[38]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.39-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.39:09d7d01e",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "39",
        "end": "39"
      },
      "language": "grc",
      "text": "ἄμπελος ἔνθα καὶ ἔνθα, κατεκρημνῶντο δὲ πολλοὶ",
      "sequence": 39,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[39]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.40-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.40:cc67a033",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "40",
        "end": "40"
      },
      "language": "grc",
      "text": "βότρυες· ἀμφ’ ἱστὸν δὲ μέλας εἱλίσσετο κισσός,",
      "sequence": 40,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[40]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.41-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.41:08f49347",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "41",
        "end": "41"
      },
      "language": "grc",
      "text": "ἄνθεσι τηλεθάων, χαρίεις δ’ ἐπὶ καρπὸς ὀρώρει·",
      "sequence": 41,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[41]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.42-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.42:bb24028c",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "42",
        "end": "42"
      },
      "language": "grc",
      "text": "πάντες δὲ σκαλμοὶ στεφάνους ἔχον· οἳ δὲ ἰδόντες,",
      "sequence": 42,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[42]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.43-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.43:1490e7b8",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "43",
        "end": "43"
      },
      "language": "grc",
      "text": "νῆ’ ἤδη τότ’ ἔπειτα κυβερνήτην ἐκέλευον",
      "sequence": 43,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[43]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.44-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.44:44ad6f7a",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "44",
        "end": "44"
      },
      "language": "grc",
      "text": "γῇ πελάαν· ὃ δ’ ἄρα σφι λέων γένετ’ ἔνδοθι νηὸς",
      "sequence": 44,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[44]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.45-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.45:4f0d1573",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "45",
        "end": "45"
      },
      "language": "grc",
      "text": "δεινὸς ἐπ’ ἀκροτάτης, μέγα δ’ ἔβραχεν, ἐν δ’ ἄρα μέσσῃ",
      "sequence": 45,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[45]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.46-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.46:bb8cc6d5",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "46",
        "end": "46"
      },
      "language": "grc",
      "text": "ἄρκτον ἐποίησεν λασιαύχενα, σήματα φαίνων·",
      "sequence": 46,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[46]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.47-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.47:1391fc08",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "47",
        "end": "47"
      },
      "language": "grc",
      "text": "ἂν δ’ ἔστη μεμαυῖα· λέων δ’ ἐπὶ σέλματος ἄκρου",
      "sequence": 47,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[47]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.48-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.48:2b9ab649",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "48",
        "end": "48"
      },
      "language": "grc",
      "text": "δεινὸν ὑπόδρα ἰδών· οἳ δ’ ἐς πρύμνην ἐφόβηθεν,",
      "sequence": 48,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[48]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.49-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.49:43269523",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "49",
        "end": "49"
      },
      "language": "grc",
      "text": "ἀμφὶ κυβερνήτην δὲ σαόφρονα θυμὸν ἔχοντα",
      "sequence": 49,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[49]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.50-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.50:c84e89ca",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "50",
        "end": "50"
      },
      "language": "grc",
      "text": "ἔσταν ἄρ’ ἐκπληγέντες· ὃ δ’ ἐξαπίνης ἐπορούσας",
      "sequence": 50,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[50]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.51-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.51:e5bae145",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "51",
        "end": "51"
      },
      "language": "grc",
      "text": "ἀρχὸν ἕλ’, οἳ δὲ θύραζε κακὸν μόρον ἐξαλύοντες",
      "sequence": 51,
      "sourcePointers": {
        "xmlId": null,
        "elementPath": "TEI[TEI]/text[text]/body[body]/div[urn:cts:greekLit:tlg0013.tlg007.perseus-grc2]/l[51]"
      }
    },
    {
      "passageId": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2:urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.52-urn:cts:greekLit:tlg0013.tlg007.perseus-grc2.52:59d400f9",
      "sourceId": "perseus-homeric-hymn-7-dionysus-grc",
      "citation": {
        "book": "urn:cts:greekLit:tlg0013.tlg007.perseus-grc2",
        "start": "52",
        "end": "52"
      },
      "language": "grc",
      "text": "πάντες ὁμῶς πήδησαν, ἐπεὶ ἴδον, εἰς ἅλα δῖαν,",
